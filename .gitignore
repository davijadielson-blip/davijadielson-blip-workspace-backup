# Workspace Cofre — regra: só .md no versionamento
# Mídia, binários e formatos não-texto vão para o Google Drive

# 🖼️ Imagens → Drive
*.jpg
*.jpeg
*.png
*.gif
*.svg
*.webp
*.ico
*.bmp
*.tiff

# 🎬 Vídeos/Áudio → Drive
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.mp3
*.wav
*.ogg
*.flac
*.aac
*.m4a

# 📦 Compactados → Drive
*.zip
*.tar
*.gz
*.bz2
*.rar
*.7z

# 📊 Planilhas/docs → Drive
*.xlsx
*.xls
*.doc
*.docx
*.pdf
*.csv

# 🧹 Temporários
*.log
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.env

# 📁 Pastas com mídia grande
edicao-bastidores/
.kit-import/starter-kit-openclaw-v2.5.7/
# 🔐 Secrets → local-only, never push
.gog/
scripts/.secrets/
scripts/.venv/
scripts/data/keyring/
.secrets/
client_secret*.json
media/inbound/

# Runtime local state → fora do Git por padrão
70-agentes/runtime/*/openclaw-workspace-state.json
70-agentes/runtime/*/memory/
70-agentes/runtime/*/media/inbound/
memory/.dreams/*.u4s-*

__pycache__/
*.pyc
BOOTSTRAP.md
BOOTSTRAP.md.concluido
